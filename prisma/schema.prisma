generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  userId                     String                          @id
  displayName                String
  pictureUrl                 String?
  role                       UserRole?
  points                     Int                             @default(0)
  visitCount                 Int                             @default(0)
  nextRank                   String                          @default("regular")
  lastCheckInAt              DateTime?
  officialAccountId          String?
  officialLinkedAt           DateTime?
  surveyId                   String?                         @unique
  googleReviewId             String?                         @unique
  rank                       Rank                            @relation(fields: [nextRank], references: [id])
  officialAccount            OfficialAccount?                @relation(fields: [officialAccountId], references: [id])
  survey                     UserSurvey?                     @relation(fields: [surveyId], references: [id])
  googleReview               GoogleReview?                   @relation(fields: [googleReviewId], references: [id], onDelete: SetNull)
  checkIns                   UserCheckIn[]
  histories                  UserHistory[]
  userGifts                  UserGift[]
  storeOperationPermissions  StaffStoreOperationPermission[]
  staffShiftSubmissions      StaffShiftSubmission[]
  staffShiftAssignments      StaffShiftAssignment[]
  staffShiftDraftAssignments StaffShiftDraftAssignment[]
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt

  @@index([officialAccountId, createdAt])
  @@map("users")
}

model GoogleReview {
  id         String   @id @default(cuid())
  reviewText String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?

  @@map("google_reviews")
}

enum UserRole {
  staff
}

enum StaffShiftAvailabilityStatus {
  UNSET
  AVAILABLE
  UNAVAILABLE
}

model UserSurvey {
  id                      String                   @id @default(cuid())
  gender                  String?
  visitFrequency          String?
  companionType           String?
  birthDate               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  onboardingSurveyAnswers OnboardingSurveyAnswer[]

  @@map("user_surveys")
}

enum OnboardingSurveyQuestionType {
  single_select
  date
  text
}

enum OnboardingSurveyPresetKey {
  gender
  visitFrequency
  companionType
  birthDate
}

model OnboardingSurveyQuestionSetting {
  id                String                       @id @default(cuid())
  scopeKey          String
  officialAccountId String?
  questionKey       String
  presetKey         OnboardingSurveyPresetKey?
  questionType      OnboardingSurveyQuestionType
  label             String
  options           Json?
  placeholder       String?
  isEnabled         Boolean                      @default(true)
  isRequired        Boolean                      @default(true)
  sortOrder         Int
  officialAccount   OfficialAccount?             @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  answers           OnboardingSurveyAnswer[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([scopeKey, questionKey])
  @@index([scopeKey, presetKey])
  @@index([officialAccountId])
  @@index([scopeKey, sortOrder])
  @@map("onboarding_survey_question_settings")
}

model OnboardingSurveyAnswer {
  id          String                          @id @default(cuid())
  surveyId    String
  questionId  String
  questionKey String
  valueText   String?
  valueOption String?
  valueDate   DateTime?
  survey      UserSurvey                      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question    OnboardingSurveyQuestionSetting @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@unique([surveyId, questionId])
  @@index([questionKey])
  @@map("onboarding_survey_answers")
}

enum GiftExpiryType {
  DAYS_AFTER_ISSUE
  FIXED_DATE
}

model Gift {
  id                         String                   @id @default(cuid())
  title                      String
  usageGuide                 String
  expiryType                 GiftExpiryType
  expiryDays                 Int?
  expiryAt                   DateTime?
  imageUrl                   String
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  userGifts                  UserGift[]
  visitGachaSettings         VisitGachaSetting[]
  signupBenefitSettings      MemberBenefitSetting[]   @relation("SignupBenefitGift")
  reviewBenefitSettings      MemberBenefitSetting[]   @relation("ReviewBenefitGift")
  topRankLoopBenefitSettings MemberBenefitSetting[]   @relation("TopRankLoopBenefitGift")
  rankBenefitGiftSettings    RankBenefitGiftSetting[]

  @@map("gifts")
}

model VisitGachaSetting {
  id                String                      @id @default(cuid())
  scopeKey          String                      @unique
  officialAccountId String?
  giftId            String
  winImageUrl       String?
  loseImageUrl      String?
  winProbability    Int
  isActive          Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  officialAccount   OfficialAccount?            @relation(fields: [officialAccountId], references: [id])
  gift              Gift                        @relation(fields: [giftId], references: [id], onDelete: Cascade)
  rankProbabilities VisitGachaRankProbability[]

  @@index([officialAccountId])
  @@index([giftId])
  @@map("visit_gacha_settings")
}

model VisitGachaRankProbability {
  id             String            @id @default(cuid())
  settingId      String
  rankId         String
  winProbability Int
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  setting        VisitGachaSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  rank           Rank              @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@unique([settingId, rankId])
  @@index([rankId])
  @@map("visit_gacha_rank_probabilities")
}

model GiftImageTemplate {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  sortOrder Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gift_image_templates")
}

model UserGift {
  id                  String     @id @default(cuid())
  userId              String
  giftId              String
  isUsed              Boolean    @default(false)
  usedAt              DateTime?
  issuedAt            DateTime   @default(now())
  expiresAt           DateTime
  transferredFromId   String?
  transferredToUserId String?
  transferredAt       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  gift                Gift       @relation(fields: [giftId], references: [id], onDelete: Cascade)
  transferredFrom     UserGift?  @relation("GiftTransfer", fields: [transferredFromId], references: [id], onDelete: SetNull)
  transferredTo       UserGift[] @relation("GiftTransfer")

  @@index([userId, isUsed])
  @@index([userId, isUsed, expiresAt, issuedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([giftId])
  @@index([expiresAt])
  @@map("user_gifts")
}

model Rank {
  id                          String                      @id
  name                        String
  minPoints                   Int
  maxPoints                   Int
  users                       User[]
  visitGachaRankProbabilities VisitGachaRankProbability[]
  rankBenefitGiftSettings     RankBenefitGiftSetting[]

  @@map("ranks")
}

model AdminUser {
  id                String           @id
  passwordHash      String
  officialAccountId String?
  officialAccount   OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("admin_user")
}

model OfficialAccount {
  id                               String                            @id @default(cuid())
  lineBasicId                      String                            @unique
  name                             String?
  users                            User[]
  adminUsers                       AdminUser[]
  onboardingSurveyQuestionSettings OnboardingSurveyQuestionSetting[]
  userHistories                    UserHistory[]
  checkIns                         UserCheckIn[]
  visitGachaSettings               VisitGachaSetting[]
  lineDeliveryTriggerSettings      LineDeliveryTriggerSetting[]
  staffOperationPermissions        StaffStoreOperationPermission[]
  staffShiftSubmissions            StaffShiftSubmission[]
  staffShiftSchedules              StaffShiftSchedule[]
  staffShiftScheduleDrafts         StaffShiftScheduleDraft[]
  memberBenefitSettings            MemberBenefitSetting[]
  storeStatus                      StoreStatus?
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt

  @@map("official_accounts")
}

enum LineDeliveryTriggerType {
  USER_SIGNUP
  CHECKIN_POINT_GRANTED
  RANK_UP
  BIRTHDAY
  GIFT_EXPIRES
}

enum DeliveryVisitCountSegment {
  ZERO
  ONE
  TWO_TO_FOUR
  FIVE_TO_NINE
  TEN_OR_MORE
}

model LineDeliveryTriggerSetting {
  id                       String                      @id @default(cuid())
  officialAccountId        String?
  title                    String
  triggerType              LineDeliveryTriggerType
  notificationText         String                      @default("")
  messages                 Json?
  message                  String
  targetRankIds            String[]                    @default([])
  targetGender             String?
  targetVisitCountSegments DeliveryVisitCountSegment[] @default([])
  delayDays                Int                         @default(0)
  deliveryHourJst          Int?
  isActive                 Boolean                     @default(true)
  officialAccount          OfficialAccount?            @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([officialAccountId])
  @@index([triggerType])
  @@map("line_delivery_trigger_settings")
}

model MemberBenefitSetting {
  id                      String                   @id @default(cuid())
  scopeKey                String                   @unique
  officialAccountId       String?
  signupGiftId            String?
  reviewGiftId            String?
  reviewPasswordHash      String?
  topRankLoopGiftId       String?
  officialAccount         OfficialAccount?         @relation(fields: [officialAccountId], references: [id])
  signupGift              Gift?                    @relation("SignupBenefitGift", fields: [signupGiftId], references: [id], onDelete: SetNull)
  reviewGift              Gift?                    @relation("ReviewBenefitGift", fields: [reviewGiftId], references: [id], onDelete: SetNull)
  topRankLoopGift         Gift?                    @relation("TopRankLoopBenefitGift", fields: [topRankLoopGiftId], references: [id], onDelete: SetNull)
  rankBenefitGiftSettings RankBenefitGiftSetting[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([officialAccountId])
  @@index([signupGiftId])
  @@index([reviewGiftId])
  @@index([topRankLoopGiftId])
  @@map("member_benefit_settings")
}

model RankBenefitGiftSetting {
  id        String               @id @default(cuid())
  settingId String
  rankId    String
  giftId    String
  setting   MemberBenefitSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  rank      Rank                 @relation(fields: [rankId], references: [id], onDelete: Cascade)
  gift      Gift                 @relation(fields: [giftId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([settingId, rankId])
  @@index([rankId])
  @@index([giftId])
  @@map("rank_benefit_gift_settings")
}

model StaffStoreOperationPermission {
  id                String          @id @default(cuid())
  userId            String
  officialAccountId String
  canOpen           Boolean         @default(false)
  canClose          Boolean         @default(false)
  user              User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  officialAccount   OfficialAccount @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, officialAccountId])
  @@index([officialAccountId])
  @@map("staff_store_operation_permissions")
}

model StaffShiftSubmission {
  id                String                   @id @default(cuid())
  userId            String
  officialAccountId String
  month             String
  submittedAt       DateTime?
  user              User                     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  officialAccount   OfficialAccount          @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  entries           StaffShiftAvailability[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([userId, officialAccountId, month])
  @@index([officialAccountId, month])
  @@index([userId, month])
  @@map("staff_shift_submissions")
}

model StaffShiftAvailability {
  id           String                       @id @default(cuid())
  submissionId String
  day          Int
  status       StaffShiftAvailabilityStatus @default(UNSET)
  startTime    String?
  endTime      String?
  isFree       Boolean                      @default(false)
  memo         String?
  submission   StaffShiftSubmission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([submissionId, day])
  @@index([status])
  @@map("staff_shift_availabilities")
}

model StaffShiftSchedule {
  id                String                 @id @default(cuid())
  officialAccountId String
  month             String
  officialAccount   OfficialAccount        @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  assignments       StaffShiftAssignment[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([officialAccountId, month])
  @@index([officialAccountId, month])
  @@map("staff_shift_schedules")
}

model StaffShiftAssignment {
  id         String             @id @default(cuid())
  scheduleId String
  userId     String
  day        Int
  startTime  String?
  endTime    String?
  isFree     Boolean            @default(false)
  memo       String?
  schedule   StaffShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([scheduleId, day])
  @@index([userId])
  @@map("staff_shift_assignments")
}

model StaffShiftScheduleDraft {
  id                String                      @id @default(cuid())
  officialAccountId String
  month             String
  officialAccount   OfficialAccount             @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  assignments       StaffShiftDraftAssignment[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([officialAccountId, month])
  @@index([officialAccountId, month])
  @@map("staff_shift_schedule_drafts")
}

model StaffShiftDraftAssignment {
  id        String                  @id @default(cuid())
  draftId   String
  userId    String
  day       Int
  startTime String?
  endTime   String?
  isFree    Boolean                 @default(false)
  memo      String?
  draft     StaffShiftScheduleDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([draftId, day])
  @@index([userId])
  @@map("staff_shift_draft_assignments")
}

model StoreStatus {
  id                String          @id @default(cuid())
  officialAccountId String          @unique
  isOpen            Boolean         @default(false)
  officialAccount   OfficialAccount @relation(fields: [officialAccountId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([officialAccountId])
  @@map("store_statuses")
}

model UserCheckIn {
  id                String           @id @default(cuid())
  userId            String
  checkedInAt       DateTime
  isFirstVisit      Boolean
  isRepeatVisit     Boolean
  officialAccountId String?
  user              User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  officialAccount   OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([userId, checkedInAt])
  @@index([checkedInAt])
  @@index([officialAccountId, checkedInAt])
  @@index([officialAccountId, userId, checkedInAt])
  @@map("user_checkins")
}

model UserHistory {
  id                String           @id @default(cuid())
  targetUserId      String
  actorType         String
  actorId           String?
  action            String
  metadata          Json?
  officialAccountId String?
  targetUser        User             @relation(fields: [targetUserId], references: [userId], onDelete: Cascade)
  officialAccount   OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([action, officialAccountId, createdAt])
  @@map("user_history")
}

model AdminAuthUser {
  id              String             @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  username        String?            @unique
  displayUsername String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sessions        AdminAuthSession[]
  accounts        AdminAuthAccount[]

  @@unique([email])
  @@map("admin_auth_user")
}

model AdminAuthSession {
  id        String        @id
  expiresAt DateTime
  token     String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AdminAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_auth_session")
}

model AdminAuthAccount {
  id                    String        @id
  accountId             String
  providerId            String
  userId                String
  user                  AdminAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@map("admin_auth_account")
}

model AdminAuthVerification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("admin_auth_verification")
}
